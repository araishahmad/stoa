# Bootstrap HTTP template only. Configure HTTPS before a public launch.
# Replace YOUR_CONFIRMED_DOMAIN with the owner's approved hostname.
# No www/apex choice, certificate paths or canonical redirects are assumed.
# Install as a separate site after reviewing the VPS's existing Nginx config.
server {
    listen 80;
    listen [::]:80;
    server_name YOUR_CONFIRMED_DOMAIN;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Forwarded "";

        # Preserve Next.js streaming and the original 404/5xx responses.
        proxy_buffering off;
        proxy_intercept_errors off;
        proxy_cache off;
    }
}
